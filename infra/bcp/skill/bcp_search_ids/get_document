#!/usr/bin/env python3
"""get_document <docid>  -- full text (first 8192 tokens); wrapped in <<<Rnnnn BEGIN ... Rnnnn END>>>."""
import json, os, sys, urllib.parse, urllib.request, urllib.error
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _rid import next_rid
if len(sys.argv) != 2:
    sys.exit("usage: get_document <docid>")
base = os.environ.get("BCP_SEARCH_URL", "http://127.0.0.1:8100")
try:
    d = json.load(urllib.request.urlopen(f"{base}/doc?" + urllib.parse.urlencode({"docid": sys.argv[1]}), timeout=60))
except urllib.error.HTTPError as e:
    sys.exit(f"error: {json.load(e).get('error')}")
rid = next_rid()
print(f"<<<{rid} BEGIN document docid={d['docid']} url={d['url']} tokens={d['n_tokens']}" + (" (truncated to 8192)" if d["truncated"] else ""))
print(d["text"])
print(f"{rid} END>>>")
